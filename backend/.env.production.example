NODE_ENV=production
PORT=3000
API_HOST=127.0.0.1
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=12mb

# Production PostgreSQL. Use a dedicated least-privilege NCA GRC account.
DB_HOST=replace-with-nca-postgresql-host
DB_PORT=5432
DB_NAME=nca_grc
DB_USER=nca_grc_app
DB_PASSWORD=replace-with-production-database-password
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_APPLICATION_NAME=nca-grc-api
DB_SSL=true
DB_SSL_ALLOW_SELF_SIGNED=false
DB_SSL_CA=

# Generate two different secrets of at least 32 random characters.
JWT_SECRET=replace-with-a-long-random-production-secret
COMMUNICATION_ENCRYPTION_KEY=replace-with-a-different-long-random-production-secret

# Replace with the internal HTTPS name assigned by NCA ICT.
FRONTEND_URL=https://grc.nca.org.gh
CORS_ORIGINS=https://grc.nca.org.gh

PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5
PASSWORD_EXPIRY_DAYS=90
PASSWORD_EXPIRY_WARNING_DAYS=14
PASSWORD_RESET_MINUTES=30
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

WORKPLAN_ORIGINAL_RETENTION_DAYS=365

# Leave blank. The application creates a unique temporary password for every account.
DEFAULT_TEMP_PASSWORD=
TEST_USER_PASSWORD=

# NCA corporate mail system. Obtain every value from NCA IT.
# Authenticated SMTP: supply both SMTP_USER and SMTP_PASSWORD.
# Approved server/IP relay: leave both SMTP_USER and SMTP_PASSWORD blank.
SMTP_HOST=replace-with-nca-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-nca-grc-service-account
SMTP_PASSWORD=replace-with-service-account-password
SMTP_FROM=NCA GRC <no-reply@nca.org.gh>
# Exact, explicitly approved service senders only. Never allow a whole public domain.
SMTP_ALLOWED_EXTERNAL_SENDERS=
# false = STARTTLS (normally port 587); true = implicit TLS (normally port 465).
SMTP_SECURE=false
# Keep certificate validation enabled. Change only under a documented NCA IT exception.
SMTP_ALLOW_SELF_SIGNED=false
MAIL_FROM=no-reply@nca.org.gh

DISABLE_COMMUNICATION_WORKER=false
EMAIL_QUEUE_BATCH_SIZE=20
EMAIL_QUEUE_INTERVAL_MS=30000
EMAIL_QUEUE_ALERT_THRESHOLD=50

# Conversational assistant. Production defaults preserve local, read-only fallback.
# Supply AI_API_KEY through the approved secret store, never this file.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# Optional loopback-only embedding endpoint used for local semantic routing.
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=all-MiniLM-L6-v2-Q4_K_M
AI_TIMEOUT_MS=20000
AI_ROUTER_TIMEOUT_MS=650
AI_READINESS_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=900
ASSISTANT_JSON_BODY_LIMIT=64kb
AI_GOVERNED_CONTEXT_EXTERNAL_ALLOWED=false
AI_VOICE_ENABLED=false
# Enable only after browser speech processing and autoplay behaviour are approved.
AI_VOICE_GREETING_ENABLED=false
AI_VOICE_AUTO_START_ENABLED=false
AI_PROCESSING_REGION=unverified
AI_HOSTING_REGION=unverified
AI_AUDIT_RETENTION_POLICY=undecided
