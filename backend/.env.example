NODE_ENV=development
PORT=3000
API_HOST=127.0.0.1
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=12mb

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nca_grc
DB_USER=postgres
DB_PASSWORD=replace-with-a-local-database-password
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_APPLICATION_NAME=nca-grc-api
DB_SSL=false
DB_SSL_ALLOW_SELF_SIGNED=false
# DB_SSL_CA may contain the PEM certificate text supplied by NCA ICT.
DB_SSL_CA=

# Use independent, randomly generated production secrets.
JWT_SECRET=replace-with-a-long-random-jwt-secret
COMMUNICATION_ENCRYPTION_KEY=replace-with-a-different-long-random-encryption-key

FRONTEND_URL=http://localhost:5500
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

PASSWORD_MIN_LENGTH=8
PASSWORD_HISTORY_COUNT=5
PASSWORD_EXPIRY_DAYS=90
PASSWORD_EXPIRY_WARNING_DAYS=14
PASSWORD_RESET_MINUTES=30
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Original Excel evidence is purged after this period; compressed JSON and structured records remain.
WORKPLAN_ORIGINAL_RETENTION_DAYS=365

# Optional bootstrap/onboarding setting. Do not use a shared default in production.
DEFAULT_TEMP_PASSWORD=
TEST_USER_PASSWORD=

# Obtain these values from NCA IT. Use either authenticated SMTP (both user and
# password supplied) or an approved relay (both left blank).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
# Keep false unless NCA ICT explicitly authorises a private/self-signed SMTP certificate.
SMTP_ALLOW_SELF_SIGNED=false
MAIL_FROM=

DISABLE_COMMUNICATION_WORKER=false
EMAIL_QUEUE_BATCH_SIZE=20
EMAIL_QUEUE_INTERVAL_MS=30000
EMAIL_QUEUE_ALERT_THRESHOLD=50
